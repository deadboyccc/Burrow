# burrow configuration reference.
#
# Don't copy this by hand: `./burrow init --domain notes.example.com` writes a
# real .env with a fresh secret. This file documents every setting and its
# default value (DOMAIN, which has no default, shows an example). After
# editing .env, apply it with `./burrow up`.
# Values are plain KEY=value. .env is parsed as data, never executed.

# --- Identity --------------------------------------------------------------
# stealth: your own domain + a real decoy website + a real TLS certificate.
#          Probes and browsers see an ordinary site. Recommended.
# simple:  no domain; impersonate COVER_DOMAIN. Works, but SNI and IP don't
#          match, which a careful censor can notice.
BURROW_MODE=stealth
# stealth: a domain whose A record points at this server. No domain? Your IP as a
# free wildcard-DNS name works too: 203-0-113-7.sslip.io (set LINK_HOST to the IP).
DOMAIN=notes.example.com
# simple: a popular HTTPS site that is reachable where your users are.
COVER_DOMAIN=
# FakeTLS secret: ee + 16 random bytes + hex(DOMAIN or COVER_DOMAIN).
# Generated by `burrow init`, replaced by `burrow rotate` (revokes old links).
SECRET=
# Detected by `burrow init`. Used for links (simple mode) and `mtg doctor`.
PUBLIC_IPV4=
PUBLIC_IPV6=
# What share links point at. Default: DOMAIN (stealth) or PUBLIC_IPV4 (simple).
# An IP keeps working even if the censor poisons DNS for your domain.
LINK_HOST=

# --- Network ---------------------------------------------------------------
BIND_ADDR=0.0.0.0
# The public port. 443 is what real HTTPS uses; anything else stands out.
PROXY_PORT=443
# stealth: Let's Encrypt HTTP-01 challenges and http->https redirects.
HTTP_PORT=80
# Prometheus metrics, published on 127.0.0.1 only.
METRICS_PORT=3129
# Also accept clients over IPv6 (dual-stack Docker network).
ENABLE_IPV6=false
# Private Docker network between mtg and the decoy. Change only on conflicts.
EDGE_SUBNET=10.203.47.0/28
DECOY_IP=10.203.47.10
EDGE_SUBNET6=fd42:7572:726f:77::/64

# --- TLS for the decoy site (stealth mode) ---------------------------------
# acme: real certificate from Let's Encrypt. internal: self-signed (tests).
TLS_MODE=acme
ACME_EMAIL=
# e.g. https://acme-staging-v02.api.letsencrypt.org/directory while testing.
ACME_CA=

# --- Upstream --------------------------------------------------------------
# How mtg resolves names: DNS-over-HTTPS by default (no plaintext DNS leaks).
DNS_RESOLVER=https://1.1.1.1
PREFER_IP=prefer-ipv4
# If Telegram itself is blocked from this server, chain through SOCKS5
# (space-separated; two or more are load-balanced).
UPSTREAM_PROXIES=

# --- Defenses --------------------------------------------------------------
# FakeTLS hellos carry a timestamp; older or newer than this are refused.
TIME_SKEW=5s
# Memory for the anti-replay cache (replayed hellos are sent to the decoy).
ANTI_REPLAY_SIZE=1mib
# Drop known-abusive IPs (FireHOL lists, refreshed daily).
BLOCKLIST_ENABLED=true
BLOCKLIST_URLS="https://iplists.firehol.org/files/firehol_abusers_1d.netset https://iplists.firehol.org/files/spamhaus_drop.netset"
# Absolute path to your own netset file (one IP or CIDR per line).
LOCAL_BLOCKLIST=
# If set, ONLY these networks may connect (URLs and/or a local file).
ALLOWLIST_URLS=""
LOCAL_ALLOWLIST=
# HTTPS URLs mtg fetches to learn real traffic timing and mimic it.
DOPPELGANGER_URLS=""

# --- Capacity --------------------------------------------------------------
CONCURRENCY=8192
IDLE_TIMEOUT=5m
MTG_MEMORY_LIMIT=512m
DECOY_MEMORY_LIMIT=256m

# --- Observability ---------------------------------------------------------
# off = keep no container logs at all (mtg logs client IPs at info level).
LOGGING=on
DEBUG=false
